{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pc_relay.health.v1",
  "title": "PC Relay durable freshness health",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "health_version",
    "pid",
    "branch",
    "live",
    "status",
    "phase",
    "updated_at_unix",
    "started_at_unix",
    "last_sync_at_unix",
    "last_cycle_completed_at_unix",
    "last_result_published_at_unix",
    "local_head",
    "remote_head",
    "request_count",
    "result_count",
    "backlog_count",
    "current_request_id",
    "last_error",
    "last_reconciliation_request_id",
    "reconciliation_required"
  ],
  "properties": {
    "health_version": {
      "const": "pc_relay.health.v1"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "live": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "starting",
        "process_exists",
        "healthy",
        "degraded"
      ]
    },
    "phase": {
      "enum": [
        "startup",
        "publish_pending",
        "sync_fetch",
        "sync_complete",
        "execute_request",
        "reconcile_interrupted_side_effect",
        "result_published",
        "idle",
        "cycle_error"
      ]
    },
    "updated_at_unix": {
      "type": "number",
      "minimum": 0
    },
    "started_at_unix": {
      "type": "number",
      "minimum": 0
    },
    "last_sync_at_unix": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "last_cycle_completed_at_unix": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "last_result_published_at_unix": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "local_head": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "remote_head": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "request_count": {
      "type": "integer",
      "minimum": 0
    },
    "result_count": {
      "type": "integer",
      "minimum": 0
    },
    "backlog_count": {
      "type": "integer",
      "minimum": 0
    },
    "current_request_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._-]{1,80}$"
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_reconciliation_request_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._-]{1,80}$"
    },
    "reconciliation_required": {
      "type": "boolean"
    }
  }
}
