{
  "version": "pc_relay.request.v1",
  "id": "20261012-curator-telegram-bot-capability-2215-03",
  "action": "shell.run",
  "params": {
    "argv": [
      "powershell.exe",
      "-NoProfile",
      "-Command",
      "$ErrorActionPreference='Continue';$out=[ordered]@{checkedAt=(Get-Date).ToString('o')};try{$j=Invoke-RestMethod -Method GET -Uri 'http://127.0.0.1:17448/api/status' -TimeoutSec 6;$out.statusKeys=@($j.PSObject.Properties.Name | Select-Object -First 25);$s=if($j.settings){$j.settings}else{if($j.state.settings){$j.state.settings}else{$null}}};if($s){$out.telegram=[ordered]@{notifyEnabled=$s.telegramNotifyEnabled;tokenConfigured=$s.telegramBotTokenConfigured;chatIdConfigured=[bool]($s.telegramChatId);threadIdConfigured=[bool]($s.telegramThreadId)}}}catch{$out.error=$_.Exception.GetType().Name};try{$t=Invoke-RestMethod -Method GET -Uri 'http://127.0.0.1:17448/api/ai-profiles' -TimeoutSec 5;$out.aiProfiles=@($t.aiProfiles|Where-Object{$_.provider -eq 'chatgpt'}|ForEach-Object{[ordered]@{name=$_.name;port=$_.debugPort;workerConnected=$_.workerConnected}})} }catch{$out.profileError=$_.Exception.GetType().Name};$out|ConvertTo-Json -Compress -Depth 5"
    ],
    "cwd": "E:\\"
  },
  "timeout_ms": 19000,
  "note": "Read-only Bridge status and ChatGPT debug-port metadata; return only Telegram configured booleans, NEVER secrets."
}
