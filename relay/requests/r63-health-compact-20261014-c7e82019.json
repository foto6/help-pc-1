{
  "version": "pc_relay.request.v1",
  "id": "r63-health-compact-20261014-c7e82019",
  "action": "shell.run",
  "params": {
    "argv": [
      "powershell.exe",
      "-NoProfile",
      "-NonInteractive",
      "-Command",
      "$ErrorActionPreference='Stop';$h=Invoke-RestMethod -Uri 'http://127.0.0.1:17448/api/health' -TimeoutSec 5;Write-Output ('HEALTH='+$h.state);$reasons=@($h.reasons);Write-Output ('REASON_COUNT='+$reasons.Count);foreach($reason in $reasons){Write-Output ('REASON='+([string]$reason).Substring(0,[Math]::Min(180,([string]$reason).Length)))};Write-Output ('QUEUE_ACTIVE='+$h.assignmentQueue.active);Write-Output ('QUEUE_QUEUED='+$h.assignmentQueue.queued);Write-Output ('QUEUE_PAUSED='+$h.assignmentQueue.paused)"
    ],
    "cwd": "E:\\"
  },
  "timeout_ms": 14000,
  "note": "Read-only compact actual R63 health reason labels and queue state; no sensitive provider content"
}
