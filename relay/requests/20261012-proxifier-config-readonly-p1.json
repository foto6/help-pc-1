{
  "version": "pc_relay.request.v1",
  "id": "20261012-proxifier-config-readonly-p1",
  "action": "shell.run",
  "params": {
    "argv": [
      "powershell.exe",
      "-NoProfile",
      "-Command",
      "$ErrorActionPreference='Continue'\n$o=[ordered]@{stage='proxifier_read_only_discovery'}\n$o.proxifierProcesses=@(Get-Process -ErrorAction SilentlyContinue|Where-Object{$_.ProcessName -match '^Proxifier|^pxfcfg|^Pxf' }|Select-Object -First 10|ForEach-Object{@{name=$_.ProcessName;pid=$_.Id;exe=$_.Path}})\n$o.possibleConfigPaths=@()\n$dirs=@(\"$env:APPDATA\\Proxifier\",\"$env:APPDATA\\Proxifier4\",\"$env:LOCALAPPDATA\\Proxifier\",\"$env:LOCALAPPDATA\\Proxifier4\",\"$env:PROGRAMDATA\\Proxifier\",\"$env:PROGRAMFILES\\Proxifier\")\nforeach($dir in $dirs){if($dir -and (Test-Path -LiteralPath $dir -PathType Container)){try{$items=Get-ChildItem -LiteralPath $dir -File -Recurse -Depth 2 -ErrorAction SilentlyContinue |Where-Object{ $_.Extension -in @('.ppx','.prx','.ini','.xml','.cfg') -or $_.Name -match 'profile|config|rule'}|Select-Object -First 30|ForEach-Object{@{name=$_.Name;directory=$_.DirectoryName;bytes=$_.Length;extension=$_.Extension}};$o.possibleConfigPaths+=@{folder=$dir;items=@($items)}}catch{}}}\ntry{$reg=Get-ItemProperty 'HKCU:\\Software\\Initex\\Proxifier' -ErrorAction Stop;$o.registryKeys=@($reg.PSObject.Properties.Name|Where-Object{$_ -notmatch '^PS'})}catch{$o.registryKeys=@()}\n$o|ConvertTo-Json -Depth 7 -Compress"
    ],
    "cwd": "E:\\"
  },
  "timeout_ms": 24000,
  "note": "Read-only Proxifier process and profile filename discovery. Never print credentials, proxy address/port, or raw configuration file contents. Do not change rules, network settings or browser processes."
}
