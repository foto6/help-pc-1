{
  "version": "pc_relay.request.v1",
  "id": "20261012-birthday-relay-cdp-diagnostic-r004",
  "action": "shell.run",
  "params": {
    "argv": [
      "powershell.exe",
      "-NoProfile",
      "-Command",
      "$ErrorActionPreference='Stop'; $s=[ordered]@{stage='cdp-http-probe';at=(Get-Date).ToUniversalTime().ToString('o')}; try{$tabs=Invoke-RestMethod 'http://127.0.0.1:17447/json/list' -TimeoutSec 4; $s.targets=@($tabs | Where-Object {$_.url -match '7714813321|4698340709'} | ForEach-Object {@{id=$_.id;title=$_.title;url=$_.url}});$s.total=@($tabs).Count}catch{$s.error=$_.Exception.GetType().Name}; $s | ConvertTo-Json -Compress -Depth 5"
    ],
    "cwd": "E:\\"
  },
  "timeout_ms": 14000,
  "note": "Read-only HTTP CDP diagnostic, no browsing changes."
}