tput ('STICKY_KEY_ENABLED_ON_NEXT_RESTART=True');Write-Output ('ORIGINAL_ENV_BYTES='+$length);Write-Output ('APPENDED_BYTES='+$addition.Length);Write-Output ('ROLLBACK_META='+$marker);Write-Output 'NO_SECRETS_READBACK_OR_PROVIDER_SEND'"
