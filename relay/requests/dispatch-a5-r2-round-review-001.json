{
  "version": "pc_relay.request.v1",
  "id": "dispatch-a5-r2-round-review-001",
  "action": "shell.run",
  "params": {
    "argv": [
      "powershell.exe",
      "-NoProfile",
      "-Command",
      "$xs=Invoke-RestMethod 'http://127.0.0.1:17410/json/list'; $t=$xs|Where-Object {$_.url -like '*6ab8f49f-a098-83eb-8390-979e53e97ebf*'}|Select-Object -First 1; if(-not $t){Write-Error 'target_not_found'; exit 3}; Set-Location E:\\WebAIBridge\\app; node .\\data\\direct_send_existing_agent.js --target=$($t.id) --prompt=E:\\pc-github-relay\\relay\\prompts\\a5-r2-round-review.txt"
    ],
    "cwd": "E:\\WebAIBridge\\app"
  },
  "timeout_ms": 30000,
  "note": "Dispatch A5 R2 round review; no holdout execution."
}
