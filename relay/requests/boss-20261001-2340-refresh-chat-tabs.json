{
  "version": "pc_relay.request.v1",
  "id": "boss-20261001-2340-refresh-chat-tabs",
  "action": "shell.run",
  "params": {
    "argv": [
      "powershell.exe",
      "-NoProfile",
      "-Command",
      "$OutputEncoding=[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new();$code=@'\nconst tabs=await(await fetch(\"http://127.0.0.1:17410/json/list\")).json();process.stdout.write(JSON.stringify(tabs.filter(t=>t.type===\"page\").map(t=>({id:t.id,title:t.title,url:t.url}))))\n'@;$code|node --input-type=module -"
    ],
    "cwd": "C:\\"
  },
  "timeout_ms": 10000,
  "note": "Read-only refresh of current ChatGPT CDP tab IDs/URLs"
}