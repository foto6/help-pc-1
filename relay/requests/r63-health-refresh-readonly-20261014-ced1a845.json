{
  "version": "pc_relay.request.v1",
  "id": "r63-health-refresh-readonly-20261014-ced1a845",
  "action": "shell.run",
  "params": {
    "argv": [
      "powershell.exe",
      "-NoProfile",
      "-NonInteractive",
      "-Command",
      "$ErrorActionPreference='Stop';$u='http://127.0.0.1:17448';$r=Invoke-RestMethod ($u+'/api/health/subsystems?refresh=1') -TimeoutSec 18;Write-Output ('REFRESHED='+$r.refreshed);Write-Output ('HEALTH='+$r.health.state);Write-Output ('REASONS='+(@($r.health.reasons)-join ','));$c=Invoke-RestMethod ($u+'/api/projects/control-plane/cutover-r42/status') -TimeoutSec 5;Write-Output ('R42_HOLD='+$c.cutoverState.holdActive);$a=Invoke-RestMethod ($u+'/api/supervisor-watchdog/agent-assignments') -TimeoutSec 5;Write-Output ('QUEUED='+@($a.assignments|Where-Object{$_.state -eq 'queued'}).Count);Write-Output ('ACTIVE='+@($a.assignments|Where-Object{$_.state -in @('running','dispatching','awaiting_evidence','unknown')}).Count)"
    ],
    "cwd": "E:\\"
  },
  "timeout_ms": 26000,
  "note": "One read-only official subsystem health refresh (filesystem, config, CDP target list) after stale probes, no browser navigation/focus/restart, no queue mutation"
}
