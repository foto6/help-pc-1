{
  "version": "pc_relay.request.v1",
  "id": "browser-chat-list-001",
  "action": "shell.run",
  "params": {
    "argv": [
      "powershell.exe",
      "-NoProfile",
      "-Command",
      "$xs=Invoke-RestMethod 'http://127.0.0.1:17410/json/list'; $xs | Where-Object {$_.url -like 'https://chatgpt.com/*'} | Select-Object id,title,url | ConvertTo-Json -Depth 4"
    ],
    "cwd": "E:\\pc-github-relay"
  },
  "timeout_ms": 15000,
  "note": "Short browser tab inventory for restoring canonical agent chats."
}
