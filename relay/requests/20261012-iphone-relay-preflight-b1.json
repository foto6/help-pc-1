{
  "version": "pc_relay.request.v1",
  "id": "20261012-iphone-relay-preflight-b1",
  "action": "shell.run",
  "params": {
    "argv": [
      "powershell.exe",
      "-NoProfile",
      "-Command",
      "$ErrorActionPreference='Stop'; $t=@(Invoke-RestMethod -Uri 'http://127.0.0.1:17447/json/list' -TimeoutSec 4); $r=[ordered]@{at=(Get-Date).ToUniversalTime().ToString('o');port=17447;total=$t.Count;iphoneTabs=@($t|Where-Object{$_.type -eq 'page' -and $_.url -match '^https://www\\.avito\\.ru/krasnoyarsk/telefony'}|ForEach-Object{[ordered]@{id=$_.id;title=([string]$_.title).Substring(0,[Math]::Min(100,([string]$_.title).Length));url=$_.url}})};ok=$true}; $r|ConvertTo-Json -Depth 4 -Compress"
    ],
    "cwd": "E:\\"
  },
  "timeout_ms": 12000,
  "note": "Read-only check of user-authorized isolated no-proxy Chrome CDP localhost port 17447; only public Avito iPhone tabs, no sensitive data or navigation; no process/proxy changes."
}
