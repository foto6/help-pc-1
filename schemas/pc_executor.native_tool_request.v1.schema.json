        "fs.delete",
        "fs.edit_text",
        "fs.find",
        "fs.glob",
        "fs.hash",
        "fs.list",
        "fs.mkdir",
        "fs.move",
        "fs.read_bytes",
        "fs.read_many",
        "fs.read_text",
        "fs.search",
        "fs.stat",
        "fs.write_text",
        "health.get",
        "identity.get",
        "log.read_since",
        "log.search",
        "log.tail",
        "metrics.get",
        "ops.capabilities.get",
        "ops.preflight",
        "process.inspect",
        "process.list",
        "process.managed.list",
        "process.read_output",
        "process.start",
        "process.status",
        "process.terminate",
        "search.list",
        "search.read",
        "search.start",
        "search.stop",
        "shell.session.read",
        "shell.session.start",
