{
  "contract_version": "pc_executor.native_tool_parity.v1",
  "reference_surface": "Remote Desktop Commander / Desktop Commander",
  "mappings": [
    {
      "reference": "list_devices",
      "candidate": [
        "device.info"
      ],
      "status": "local_only",
      "note": "Wave 1 exposes the authorized local device only; no remote device broker."
    },
    {
      "reference": "ping",
      "candidate": [
        "health.get"
      ],
      "status": "direct"
    },
    {
      "reference": "get_config",
      "candidate": [
        "config.get"
      ],
      "status": "read_only",
      "note": "Safety limits and contract versions only."
    },
    {
      "reference": "set_config_value",
      "candidate": [
        "config.set"
      ],
      "status": "direct",
      "note": "Explicit allowlist only; updates are atomically validated and journaled."
    },
    {
      "reference": "who_am_i",
      "candidate": [
        "identity.who_am_i"
      ],
      "status": "sanitized",
      "note": "Non-secret local account/host identity only."
    },
    {
      "reference": "shutdown",
      "candidate": [
        "agent.shutdown"
      ],
      "status": "direct",
      "note": "Journaled graceful shutdown bound to the current device/control-session/session epoch."
    },
    {
      "reference": "read_file",
      "candidate": [
        "fs.read_text",
        "fs.read_bytes",
        "log.tail"
      ],
      "status": "direct"
    },
    {
      "reference": "read_multiple_files",
      "candidate": [
        "fs.read_multiple"
      ],
      "status": "direct",
      "note": "Ordered native batch read with per-file result and aggregate byte bound."
    },
    {
      "reference": "write_file",
      "candidate": [
        "fs.write_text",
        "fs.append_text"
      ],
      "status": "direct"
    },
    {
      "reference": "write_pdf",
      "candidate": [
        "pdf.write"
      ],
      "status": "safe_core",
      "note": "Markdown create plus delete/insert modification to a new output; no in-place overwrite."
    },
    {
      "reference": "edit_block",
      "candidate": [
        "fs.edit_text"
      ],
      "status": "direct",
      "note": "Requires expected-current SHA-256 and exact replacement count."
    },
    {
      "reference": "list_directory",
      "candidate": [
        "fs.list"
      ],
      "status": "direct"
    },
    {
      "reference": "move_file",
      "candidate": [
        "fs.move"
      ],
      "status": "direct"
    },
    {
      "reference": "create_directory",
      "candidate": [
        "fs.mkdir"
      ],
      "status": "direct"
    },
    {
      "reference": "get_file_info",
      "candidate": [
        "fs.stat",
        "fs.hash"
      ],
      "status": "direct"
    },
    {
      "reference": "start_search",
      "candidate": [
        "search.start"
      ],
      "status": "stateful",
      "note": "Creates a generation-scoped pc_executor.search_session.v1 handle with bounded background execution."
    },
    {
      "reference": "get_more_search_results",
      "candidate": [
        "search.read"
      ],
      "status": "stateful",
      "note": "Reads an existing search handle by absolute result offset; negative offsets provide tail semantics."
    },
    {
      "reference": "stop_search",
      "candidate": [
        "search.stop"
      ],
      "status": "stateful",
      "note": "Cancels only the addressed search handle; final results remain readable during bounded retention."
    },
    {
      "reference": "list_searches",
      "candidate": [
        "search.list"
      ],
      "status": "stateful",
      "note": "Enumerates active and retained current-generation search handles with lifecycle metadata."
    },
    {
      "reference": "start_process",
      "candidate": [
        "process.start",
        "shell.session.start"
      ],
      "status": "direct"
    },
    {
      "reference": "read_process_output",
      "candidate": [
        "process.read_output",
        "shell.session.read"
      ],
      "status": "direct"
    },
    {
      "reference": "interact_with_process",
      "candidate": [
        "shell.session.write_stdin"
      ],
      "status": "direct"
    },
    {
      "reference": "list_sessions",
      "candidate": [
        "process.managed.list",
        "process.status"
      ],
      "status": "direct"
    },
    {
      "reference": "force_terminate",
      "candidate": [
        "process.terminate"
      ],
      "status": "direct",
      "note": "Managed current-generation handles only."
    },
    {
      "reference": "list_processes",
      "candidate": [
        "process.list",
        "process.inspect"
      ],
      "status": "direct"
    },
    {
      "reference": "kill_process",
      "candidate": [
        "system.process.kill"
      ],
      "status": "direct",
      "note": "Requires PID plus expected executable name; Windows uses direct process handles."
    },
    {
      "reference": "get_usage_stats",
      "candidate": [
        "diagnostics.usage_stats"
      ],
      "status": "sanitized",
      "note": "Native Executor usage counters only; no vendor billing/quota data."
    },
    {
      "reference": "get_recent_tool_calls",
      "candidate": [
        "diagnostics.recent_tool_calls"
      ],
      "status": "sanitized",
      "note": "Metadata only; never raw arguments/results or credentials."
    },
    {
      "reference": "get_prompts",
      "candidate": [],
      "status": "intentional_exclusion",
      "note": "Desktop Commander vendor onboarding surface; not a native PC execution primitive."
    },
    {
      "reference": "give_feedback_to_desktop_commander",
      "candidate": [],
      "status": "intentional_exclusion",
      "note": "Desktop Commander vendor feedback surface; intentionally not reproduced."
    }
  ],
  "pagination": {
    "text": "fs.read_text start_line/end_line or tail_lines with max_bytes",
    "bytes": "fs.read_bytes offset/max_bytes",
    "log": "log.tail or log.read_since cursor",
    "process": "process.read_output/shell.session.read cursor or tail_bytes",
    "search": "search.read offset/length over a search.start handle"
  }
}
