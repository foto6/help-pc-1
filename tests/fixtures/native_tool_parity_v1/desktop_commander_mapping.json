{
  "contract_version": "pc_executor.native_tool_parity.v1",
  "reference_surface": "Remote Desktop Commander / Desktop Commander",
  "mappings": [
    {
      "reference": "list_devices",
      "candidate": [
        "device.info"
      ],
      "status": "local_only",
      "note": "Wave 1 exposes the authorized local device only; no remote device broker."
    },
    {
      "reference": "ping",
      "candidate": [
        "health.get"
      ],
      "status": "direct"
    },
    {
      "reference": "get_config",
      "candidate": [
        "config.get"
      ],
      "status": "direct",
      "note": "Returns immutable contract limits plus revisioned mutable admin config."
    },
    {
      "reference": "set_config_value",
      "candidate": [
        "config.set"
      ],
      "status": "allowlisted_atomic",
      "note": "Only explicit mutable keys are accepted; updates validate atomically with optional revision conflict detection. allowed_roots=[] is deny-all, never unrestricted."
    },
    {
      "reference": "who_am_i",
      "candidate": [
        "identity.get"
      ],
      "status": "non_sensitive",
      "note": "Returns controller/device/session metadata only; no account secrets or credentials."
    },
    {
      "reference": "shutdown",
      "candidate": [
        "device.shutdown"
      ],
      "status": "session_bound",
      "note": "Gracefully stops the current authenticated device agent/session; this is not an OS power-off action."
    },
    {
      "reference": "read_file",
      "candidate": [
        "fs.read_text",
        "fs.read_bytes",
        "log.tail"
      ],
      "status": "direct"
    },
    {
      "reference": "read_multiple_files",
      "candidate": [
        "fs.read_many"
      ],
      "status": "direct_batch",
      "note": "True deterministic bounded batch read with per-file success/error and aggregate byte limits."
    },
    {
      "reference": "write_file",
      "candidate": [
        "fs.write_text",
        "fs.append_text"
      ],
      "status": "direct"
    },
    {
      "reference": "write_pdf",
      "candidate": [],
      "status": "unsupported_hard_gap",
      "note": "PDF create/modify is not implemented in PC Core; document mutation remains an explicit capability gap."
    },
    {
      "reference": "edit_block",
      "candidate": [
        "fs.edit_text"
      ],
      "status": "direct",
      "note": "Requires expected-current SHA-256 and exact replacement count."
    },
    {
      "reference": "list_directory",
      "candidate": [
        "fs.list"
      ],
      "status": "direct"
    },
    {
      "reference": "move_file",
      "candidate": [
        "fs.move"
      ],
      "status": "direct"
    },
    {
      "reference": "create_directory",
      "candidate": [
        "fs.mkdir"
      ],
      "status": "direct"
    },
    {
      "reference": "get_file_info",
      "candidate": [
        "fs.stat",
        "fs.hash"
      ],
      "status": "direct"
    },
    {
      "reference": "start_search",
      "candidate": [
        "search.start"
      ],
      "status": "stateful",
      "note": "Creates a generation-scoped pc_executor.search_session.v1 handle with bounded background execution."
    },
    {
      "reference": "get_more_search_results",
      "candidate": [
        "search.read"
      ],
      "status": "stateful",
      "note": "Reads an existing search handle by absolute result offset; negative offsets provide tail semantics."
    },
    {
      "reference": "stop_search",
      "candidate": [
        "search.stop"
      ],
      "status": "stateful",
      "note": "Cancels only the addressed search handle; final results remain readable during bounded retention."
    },
    {
      "reference": "list_searches",
      "candidate": [
        "search.list"
      ],
      "status": "stateful",
      "note": "Enumerates active and retained current-generation search handles with lifecycle metadata."
    },
    {
      "reference": "start_process",
      "candidate": [
        "process.start",
        "shell.session.start"
      ],
      "status": "direct"
    },
    {
      "reference": "read_process_output",
      "candidate": [
        "process.read_output",
        "shell.session.read"
      ],
      "status": "direct"
    },
    {
      "reference": "interact_with_process",
      "candidate": [
        "shell.session.write_stdin"
      ],
      "status": "direct"
    },
    {
      "reference": "list_sessions",
      "candidate": [
        "process.managed.list",
        "process.status"
      ],
      "status": "direct"
    },
    {
      "reference": "force_terminate",
      "candidate": [
        "process.terminate"
      ],
      "status": "direct",
      "note": "Managed current-generation handles only."
    },
    {
      "reference": "list_processes",
      "candidate": [
        "process.list",
        "process.inspect"
      ],
      "status": "direct"
    },
    {
      "reference": "kill_process",
      "candidate": [
        "system.process.kill"
      ],
      "status": "direct",
      "note": "Requires PID plus expected executable name; Windows uses direct process handles."
    },
    {
      "reference": "get_usage_stats",
      "candidate": [
        "metrics.get"
      ],
      "status": "sanitized",
      "note": "Returns bounded operation counts/outcomes only; it is not connector billing telemetry."
    },
    {
      "reference": "get_recent_tool_calls",
      "candidate": [
        "audit.history"
      ],
      "status": "sanitized",
      "note": "Returns bounded audit metadata only; raw arguments/results/details are never exposed."
    }
  ],
  "pagination": {
    "text": "fs.read_text start_line/end_line or tail_lines with max_bytes",
    "bytes": "fs.read_bytes offset/max_bytes",
    "log": "log.tail or log.read_since cursor",
    "process": "process.read_output/shell.session.read cursor or tail_bytes",
    "search": "search.read offset/length; negative offset tails retained results and ignores length"
  },
  "excluded_non_core_commands": [
    "give_feedback_to_desktop_commander",
    "get_prompts",
    "vendor onboarding/help commands"
  ]
}
