    {
      "reference": "get_usage_stats",
      "candidate": [
        "health.get"
      ],
      "status": "partial",
      "note": "Health exposes gateway state, not connector billing/usage telemetry."
    },
    {
      "reference": "get_recent_tool_calls",
      "candidate": [],
      "status": "external_audit",
      "note": "Use the existing Executor audit/outcome journals rather than a duplicate tool log."
